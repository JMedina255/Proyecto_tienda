# =============================================================================
# .env.example — Plantilla de Variables de Entorno (Sin Credenciales Reales)
# =============================================================================
# NUNCA almacenar claves service_role, tokens de producción ni secretos en este archivo
# ni en ningún archivo rastreado por control de versiones (Regla SEC-SECR-001).

# URL pública del proyecto Supabase
EXPO_PUBLIC_SUPABASE_URL=https://ejemplo-proyecto.supabase.co

# Clave pública anónima de Supabase (restringida mediante RLS en PostgreSQL)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ficticio_para_plantilla.segura

# Identificador de entorno de ejecución ('development' | 'test' | 'production')
EXPO_PUBLIC_APP_ENV=development

# Modo de simulación de red para pruebas offline ('online' | 'offline' | 'flaky')
EXPO_PUBLIC_SYNC_NETWORK_MODE=online
